# Строка подключения к PostgreSQL (взять в панели Timeweb Cloud → Базы данных → PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# NextAuth
# Сгенерировать случайную строку: openssl rand -base64 32
NEXTAUTH_SECRET="сгенерируйте-случайную-строку"
# Публичный адрес сайта после деплоя, без слэша на конце
NEXTAUTH_URL="https://ваш-домен.ru"

# ЮKassa — Личный кабинет → Настройки → API-ключи
YOOKASSA_SHOP_ID="ваш-shopId"
YOOKASSA_SECRET_KEY="ваш-секретный-ключ"

# Почта для отправки писем при регистрации (Почта Timeweb или любой другой SMTP)
SMTP_HOST="smtp.timeweb.ru"
SMTP_PORT="587"
SMTP_USER="noreply@ваш-домен.ru"
SMTP_PASSWORD="пароль от этого почтового ящика"
SMTP_FROM="Ключевое слово <noreply@ваш-домен.ru>"

# Пароль входа в /admin (тот же принцип, что раньше — см. README про его ограничения)
ADMIN_PASSWORD="смените-меня"

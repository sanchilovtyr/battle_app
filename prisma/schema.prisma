generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Необязательный: пользователи, зарегистрировавшиеся через вход по Яндекс
  // ID, пароль не заводят — до тех пор, пока сами не зададут его через
  // восстановление пароля.
  passwordHash String?
  name         String   @default("")
  phone        String   @default("")
  createdAt    DateTime @default(now())
  // Когда пользователь последний раз открывал раздел "Новости" в ЛК —
  // всё, что новее этой даты, показывается как непрочитанное
  newsSeenAt   DateTime?
  // Тикет поддержки закрыт админом (открывается снова, когда пользователь пишет)
  supportClosed Boolean  @default(false)

  subscription        Subscription?
  businesses          Business[]
  supportMessages     SupportMessage[]
  payments            Payment[]
  passwordResetTokens PasswordResetToken[]
  metrikaConnections  MetrikaConnection[]
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String    @default("trial") // trial | start | business | agency
  status           String    @default("active") // active | cancelled
  currentPeriodEnd DateTime?
  // сохранённый способ оплаты ЮKassa для автоматических списаний за следующий период
  paymentMethodId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Business {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  businessType String
  // весь сгенерированный план целиком — чтобы можно было открыть его повторно
  planJson     Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  // Всё остальное, что пользователь вносит по бизнесу, хранится здесь, чтобы
  // данные открывались с любого браузера (раньше жили в localStorage)
  vectorId      String?
  checklistJson Json? // moduleId -> boolean[]
  funnelJson    Json? // показатели воронки по периодам
  progressJson  Json? // история выполнения плана по дням
  targetJson    Json? // цель на месяц

  @@index([userId])
}

/// Сообщения техподдержки (тикет = переписка с одним пользователем). Хранятся на
/// сервере, поэтому видны и пользователю с любого устройства, и админу.
model SupportMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  from      String // user | admin
  body      String
  imageUrl  String? // устарело, не используется
  /// Вложение (сжатая картинка jpeg/png/webp, до 900 КБ), отдаётся через /api/support/image/[id]
  image     Bytes?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Ключи внешних сервисов, введённые в админке (Яндекс Вебмастер, Google Search
/// Console). Значения хранятся зашифрованно (lib/secretBox.ts); переменные
/// окружения с теми же именами работают как запасной вариант.
model IntegrationKey {
  name      String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Правки текста встроенных модулей (lib/modules.ts) — переопределяют
/// title/why/timeToResult/steps конкретного модуля по его id из кода
model ModuleOverride {
  moduleId     String   @id
  title        String
  why          String
  timeToResult String
  steps        Json // string[]
  updatedAt    DateTime @updatedAt
}

/// Правки текста векторов аудитории (lib/vectors.ts) — переопределяют
/// поля конкретного вектора по его id из кода
model VectorOverride {
  vectorId   String   @id
  name       String
  tagline    String
  pain       String
  dream      String
  toneAdvice String
  adTips     Json // string[]
  avoid      String
  updatedAt  DateTime @updatedAt
}

/// Правки текста точек роста (lib/growthPoints.ts) — переопределяют
/// title/body/action конкретного правила по его id из кода. Для правил с
/// динамическим текстом (например, с подставленными цифрами воронки) правка
/// заменяет текст на статический — как и с обычными модулями плана
model GrowthPointOverride {
  pointId   String   @id
  title     String
  body      String
  action    String   @default("")
  updatedAt DateTime @updatedAt
}

/// Полностью новые модули, добавленные из админки — со своим простым
/// правилом скоринга (приоритет + типы бизнеса), а не кодом
model CustomModule {
  id            String   @id @default(cuid())
  title         String
  phase         String // foundation | traffic | retention
  timeToResult  String
  why           String
  steps         Json // string[]
  score         Int
  businessTypes Json // BusinessType[], пусто = все типы
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Новости сервиса, которые публикует владелец из админки — видны всем
/// зарегистрированным пользователям в личном кабинете
model NewsPost {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
}

/// Статьи блога (SEO-продвижение). Публичная статья — это запись, у которой
/// published = true и publishedAt <= now(): так отложенная публикация работает
/// без cron — достаточно выставить будущую дату. Обложка хранится прямо в базе
/// (coverData, уже сжатый JPEG) и отдаётся по адресу /blog/cover/[slug]
model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String    @default("")
  body            String
  coverData       Bytes?
  /// Отдельный флаг, чтобы списки не тянули из базы сами байты картинки
  hasCover        Boolean   @default(false)
  coverAlt        String    @default("")
  metaTitle       String    @default("")
  metaDescription String    @default("")
  keywords        String[]  @default([])
  published       Boolean   @default(false)
  publishedAt     DateTime?
  /// Автор: имя, должность/квалификация и краткая справка — для блока «Об авторе» и разметки Person
  authorName      String    @default("")
  authorRole      String    @default("")
  authorBio       String    @default("")
  /// Когда о статье последний раз сообщили Яндексу и Bing через IndexNow (null — ещё не сообщали)
  indexNowAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published, publishedAt])
}

/// SEO-монитор: список найденных проблем. Ключ (key) = код проверки + объект, поэтому
/// одна и та же проблема не плодит дубли между запусками: повторно найденная
/// обновляется, исправленная автоматически получает статус resolved
model SeoIssue {
  id           String    @id @default(cuid())
  key          String    @unique
  code         String
  /// critical | warning | info
  severity     String
  /// content | technical | indexing | setup
  category     String
  title        String
  detail       String    @default("")
  fix          String    @default("")
  /// Путь страницы или slug статьи, к которой относится проблема
  target       String    @default("")
  /// id статьи — чтобы из монитора открыть её на редактирование
  targetId     String    @default("")
  /// open | snoozed | ignored | resolved
  status       String    @default("open")
  snoozedUntil DateTime?
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  resolvedAt   DateTime?
  /// Когда о проблеме уже сообщили письмом (чтобы не слать одно и то же каждый день)
  notifiedAt   DateTime?

  @@index([status, severity])
}

/// История запусков SEO-проверки (оценка «здоровья» сайта по времени)
model SeoAuditRun {
  id           String   @id @default(cuid())
  ranAt        DateTime @default(now())
  /// manual — кнопка в админке, cron — проверка по расписанию
  trigger      String   @default("manual")
  score        Int
  critical     Int      @default(0)
  warning      Int      @default(0)
  info         Int      @default(0)
  pagesChecked Int      @default(0)
  /// false — сайт не смог обратиться к собственному адресу (обход страниц пропущен)
  networkOk    Boolean  @default(true)

  @@index([ranAt])
}

/// Ссылки для восстановления пароля по email. Хранится только хеш токена
/// (сам токен есть лишь в письме пользователя) — так утечка базы не даёт
/// возможности сбросить чей-то пароль
/// Последний визит поискового или ИИ-робота (по User-Agent; для Яндекса и Google — с проверкой по обратному DNS)
model BotVisit {
  id             String    @id @default(cuid())
  bot            String    @unique
  kind           String // search | ai
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime
  lastPath       String    @default("")
  /// Когда визит последний раз подтверждён по IP (обратный DNS). null — не подтверждался
  lastVerifiedAt DateTime?
}

/// Журнал уведомлений Яндекса и Bing о новых и изменённых страницах (IndexNow)
model IndexNowPing {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /// publish — при сохранении статьи, cron — отложенные публикации, manual — кнопка в админке
  trigger   String
  urlCount  Int
  /// Первые адреса из отправки (для просмотра в админке)
  urls      String[] @default([])
  /// HTTP-код ответа Яндекса (200/202 — принято), 0 — не удалось отправить
  yandex    Int      @default(0)
  bing      Int      @default(0)
  error     String   @default("")

  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Подключение бизнеса пользователя к его собственному счётчику Яндекс
/// Метрики — чтобы часть показателей воронки (обращения, а если настроены
/// цели — заявки и продажи) можно было подтягивать автоматически, а не
/// вводить руками каждый раз. businessId — это id бизнеса из localStorage
/// (сами бизнесы пока не переехали в базу, см. README), поэтому здесь это
/// просто строка, а не внешний ключ. Токены хранятся в зашифрованном виде
/// (см. lib/secretBox.ts)
model MetrikaConnection {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId   String
  accessToken  String
  refreshToken String?
  counterId    String?
  counterName  String?
  leadsGoalId  String?
  salesGoalId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, businessId])
}

/// Платежи ЮKassa — журнал для сверки и защиты от повторной обработки вебхука
model Payment {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  yookassaId     String   @unique
  planId         String
  amountKopecks  Int
  status         String // pending | succeeded | canceled
  createdAt      DateTime @default(now())
}

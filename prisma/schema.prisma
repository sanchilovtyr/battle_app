generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("")
  phone        String   @default("")
  createdAt    DateTime @default(now())
  // Когда пользователь последний раз открывал раздел "Новости" в ЛК —
  // всё, что новее этой даты, показывается как непрочитанное
  newsSeenAt   DateTime?

  subscription    Subscription?
  businesses      Business[]
  supportMessages SupportMessage[]
  payments        Payment[]
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String    @default("trial") // trial | start | business | agency
  status           String    @default("active") // active | cancelled
  currentPeriodEnd DateTime?
  // сохранённый способ оплаты ЮKassa для автоматических списаний за следующий период
  paymentMethodId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Business {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  businessType String
  // весь сгенерированный план целиком — чтобы можно было открыть его повторно
  planJson     Json
  createdAt    DateTime @default(now())
}

model SupportMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  from      String // user | admin
  body      String
  imageUrl  String?
  createdAt DateTime @default(now())
}

/// Правки текста встроенных модулей (lib/modules.ts) — переопределяют
/// title/why/timeToResult/steps конкретного модуля по его id из кода
model ModuleOverride {
  moduleId     String   @id
  title        String
  why          String
  timeToResult String
  steps        Json // string[]
  updatedAt    DateTime @updatedAt
}

/// Полностью новые модули, добавленные из админки — со своим простым
/// правилом скоринга (приоритет + типы бизнеса), а не кодом
model CustomModule {
  id            String   @id @default(cuid())
  title         String
  phase         String // foundation | traffic | retention
  timeToResult  String
  why           String
  steps         Json // string[]
  score         Int
  businessTypes Json // BusinessType[], пусто = все типы
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Новости сервиса, которые публикует владелец из админки — видны всем
/// зарегистрированным пользователям в личном кабинете
model NewsPost {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
}

/// Платежи ЮKassa — журнал для сверки и защиты от повторной обработки вебхука
model Payment {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  yookassaId     String   @unique
  planId         String
  amountKopecks  Int
  status         String // pending | succeeded | canceled
  createdAt      DateTime @default(now())
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Необязательный: пользователи, зарегистрировавшиеся через вход по Яндекс
  // ID, пароль не заводят — до тех пор, пока сами не зададут его через
  // восстановление пароля.
  passwordHash String?
  name         String   @default("")
  phone        String   @default("")
  createdAt    DateTime @default(now())
  // Когда пользователь последний раз открывал раздел "Новости" в ЛК —
  // всё, что новее этой даты, показывается как непрочитанное
  newsSeenAt   DateTime?

  subscription        Subscription?
  businesses          Business[]
  supportMessages     SupportMessage[]
  payments            Payment[]
  passwordResetTokens PasswordResetToken[]
  metrikaConnections  MetrikaConnection[]
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String    @default("trial") // trial | start | business | agency
  status           String    @default("active") // active | cancelled
  currentPeriodEnd DateTime?
  // сохранённый способ оплаты ЮKassa для автоматических списаний за следующий период
  paymentMethodId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Business {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  businessType String
  // весь сгенерированный план целиком — чтобы можно было открыть его повторно
  planJson     Json
  createdAt    DateTime @default(now())
}

model SupportMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  from      String // user | admin
  body      String
  imageUrl  String?
  createdAt DateTime @default(now())
}

/// Правки текста встроенных модулей (lib/modules.ts) — переопределяют
/// title/why/timeToResult/steps конкретного модуля по его id из кода
model ModuleOverride {
  moduleId     String   @id
  title        String
  why          String
  timeToResult String
  steps        Json // string[]
  updatedAt    DateTime @updatedAt
}

/// Правки текста векторов аудитории (lib/vectors.ts) — переопределяют
/// поля конкретного вектора по его id из кода
model VectorOverride {
  vectorId   String   @id
  name       String
  tagline    String
  pain       String
  dream      String
  toneAdvice String
  adTips     Json // string[]
  avoid      String
  updatedAt  DateTime @updatedAt
}

/// Правки текста точек роста (lib/growthPoints.ts) — переопределяют
/// title/body/action конкретного правила по его id из кода. Для правил с
/// динамическим текстом (например, с подставленными цифрами воронки) правка
/// заменяет текст на статический — как и с обычными модулями плана
model GrowthPointOverride {
  pointId   String   @id
  title     String
  body      String
  action    String   @default("")
  updatedAt DateTime @updatedAt
}

/// Полностью новые модули, добавленные из админки — со своим простым
/// правилом скоринга (приоритет + типы бизнеса), а не кодом
model CustomModule {
  id            String   @id @default(cuid())
  title         String
  phase         String // foundation | traffic | retention
  timeToResult  String
  why           String
  steps         Json // string[]
  score         Int
  businessTypes Json // BusinessType[], пусто = все типы
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Новости сервиса, которые публикует владелец из админки — видны всем
/// зарегистрированным пользователям в личном кабинете
model NewsPost {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
}

/// Ссылки для восстановления пароля по email. Хранится только хеш токена
/// (сам токен есть лишь в письме пользователя) — так утечка базы не даёт
/// возможности сбросить чей-то пароль
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Подключение бизнеса пользователя к его собственному счётчику Яндекс
/// Метрики — чтобы часть показателей воронки (обращения, а если настроены
/// цели — заявки и продажи) можно было подтягивать автоматически, а не
/// вводить руками каждый раз. businessId — это id бизнеса из localStorage
/// (сами бизнесы пока не переехали в базу, см. README), поэтому здесь это
/// просто строка, а не внешний ключ. Токены хранятся в зашифрованном виде
/// (см. lib/secretBox.ts)
model MetrikaConnection {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId   String
  accessToken  String
  refreshToken String?
  counterId    String?
  counterName  String?
  leadsGoalId  String?
  salesGoalId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, businessId])
}

/// Платежи ЮKassa — журнал для сверки и защиты от повторной обработки вебхука
model Payment {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  yookassaId     String   @unique
  planId         String
  amountKopecks  Int
  status         String // pending | succeeded | canceled
  createdAt      DateTime @default(now())
}
